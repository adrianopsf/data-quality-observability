      "title": "mart_customers — DQ Success Rate",
      "type": "gauge",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "100 * airflow_dag_run_duration_success{dag_id=\"olist_dq_validation\", task_id=\"run_mart_customers_checkpoint\"} / (airflow_dag_run_duration_success{dag_id=\"olist_dq_validation\", task_id=\"run_mart_customers_checkpoint\"} + airflow_dag_run_duration_failed{dag_id=\"olist_dq_validation\", task_id=\"run_mart_customers_checkpoint\"})",
