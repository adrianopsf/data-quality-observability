# PostgreSQL — same instance as ecommerce-modern-stack
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Airflow
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=changeme_generate_with_python_cryptography
AIRFLOW__WEBSERVER__SECRET_KEY=changeme_random_secret

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#data-quality-alerts

# Great Expectations
GE_DATA_DOCS_HOST=0.0.0.0
GE_DATA_DOCS_PORT=8090

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000

# Prometheus
PROMETHEUS_PORT=9090
